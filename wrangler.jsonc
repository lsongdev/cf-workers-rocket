{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rocket",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  "workers_dev": true,
  "vars": {
    "APP_URL": "http://localhost:8787"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0dffbe19c6c74d94a51facfd27dd99a1"
    }
  ]
}
